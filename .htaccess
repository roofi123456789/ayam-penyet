Options -Indexes

# Charset default UTF-8
AddDefaultCharset UTF-8

# Error pages
ErrorDocument 404 /ayam-penyet/404.php

# Security: sembunyikan file sensitif
<FilesMatch "\.(sql|log|sh|env|ini|bak)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Proteksi folder bukti QRIS - diakses via api/bayar.php?action=get_bukti
# PHP readfile() tidak terpengaruh oleh RewriteRule
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_URI} ^/ayam-penyet/admin/assets/bukti_qris/
    RewriteCond %{HTTP_REFERER} !^http://[^/]+/ayam-penyet/admin/ [NC]
    RewriteRule ^admin/assets/bukti_qris/(.*)$ - [F,L]
</IfModule>

# Cegah akses langsung ke koneksi.php dari browser
<Files "koneksi.php">
    Order Allow,Deny
    Allow from all
</Files>

# Aktifkan mod_rewrite
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /ayam-penyet/

    # Jika bukan file/direktori nyata, arahkan ke index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# PHP Settings
<IfModule mod_php.c>
    php_value upload_max_filesize 8M
    php_value post_max_size 16M
    php_value max_execution_time 60
    php_value memory_limit 256M
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 8M
    php_value post_max_size 16M
    php_value max_execution_time 60
    php_value memory_limit 256M
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>
